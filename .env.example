# Copy to .env.local for local overrides. Only VITE_* variables are exposed to the browser.
VITE_API_BASE_URL=
VITE_ENABLE_EMAIL_AUTH=false

# JedaIn Data Mode: 'mock' (default for local & unit tests) or 'supabase' (for live cross-device demo)
VITE_DATA_MODE=mock

# Supabase Configuration (only required when VITE_DATA_MODE=supabase)
VITE_SUPABASE_URL=https://yykgpvgwougibnhhxttw.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
